+  }
+  render();
+
+  document.addEventListener('click', function (ev) {
+    var b = ev.target && ev.target.closest ? ev.target.closest('[data-clear],[data-export]') : null;
+    if (!b) return;
+    if (b.hasAttribute('data-export')) {
+      var box = document.getElementById('export-box');
